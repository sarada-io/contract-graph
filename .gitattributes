# Keep authored text and literal test fixtures consistent across contributor platforms.
* text=auto eol=lf

# Preserve intentional separators in the imported, literally concatenated site fragments.
/web/site/interactions/** whitespace=-blank-at-eof
/web/site/presentation/** whitespace=-blank-at-eof
/web/site/pages/** whitespace=-blank-at-eof
# Preserve frozen third-party licence bytes.
/web/site/static/assets/fonts/OFL.txt -text -whitespace
