{
  "name": "contract-graph",
  "version": "0.1.0",
  "description": "A traversable software context graph for coding agents: route from repository to module to sub-module before reading code.",
  "type": "module",
  "bin": {
    "cg": "bin/cg.js"
  },
  "files": [
    "bin",
    "src",
    "!src/scripts/dev.js",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "try": "node src/scripts/dev.js",
    "pack": "mkdir -p build && npm pack --pack-destination ./build"
  },
  "keywords": [
    "contract-graph",
    "coding-agents",
    "context-graph",
    "llm-context",
    "governance",
    "architecture",
    "contracts",
    "ai-agents"
  ],
  "author": "sarada-io",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarada-io/contract-graph.git"
  },
  "homepage": "https://github.com/sarada-io/contract-graph#readme",
  "bugs": {
    "url": "https://github.com/sarada-io/contract-graph/issues"
  }
}
