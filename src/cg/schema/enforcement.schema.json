{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarada.io/contract-graph/schema/enforcement-v1.schema.json",
  "title": "Contract Graph repository enforcement map",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "enforcementVersion", "entries"],
  "properties": {
    "$schema": {
      "const": "https://sarada.io/contract-graph/schema/enforcement-v1.schema.json"
    },
    "enforcementVersion": { "const": "1.0" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rules", "detector"],
        "properties": {
          "rules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^P[0-9]{2}-[0-9]{2}$"
            }
          },
          "detector": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
