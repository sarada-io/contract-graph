{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarada.io/contract-graph/schema/product-v1.schema.json",
  "title": "Contract Graph product catalog",
  "description": "Repository-owned P product guidelines. The catalog ships empty; cg init preserves the installed copy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "productVersion", "principles"],
  "properties": {
    "$schema": {
      "const": "https://sarada.io/contract-graph/schema/product-v1.schema.json"
    },
    "productVersion": { "const": "1.0" },
    "principles": {
      "type": "array",
      "items": { "$ref": "#/$defs/principle" }
    }
  },
  "$defs": {
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "entries"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{2}-[0-9]{2}$"
        },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
